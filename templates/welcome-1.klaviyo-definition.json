                  {
                    "content_type": "block",
                    "type": "text",
                    "data": {
                      "content": "<h2 style=\"margin:0;color:#f9f8f1;font-weight:800;text-align:center;\">So, what is QT?</h2>",
                      "display_options": {},
                      "styles": {
                        "block_background_color": "#2e4b21",
                        "block_padding_bottom": 0,
                        "block_padding_left": 0,
                        "block_padding_right": 0,
                        "block_padding_top": 0,
                        "color": "#2e4b21",
                        "font_family": "Figtree, Arial, sans-serif",
                        "font_size": 17,
                        "inner_padding_bottom": 12,
                        "inner_padding_left": 32,
                        "inner_padding_right": 32,
                        "inner_padding_top": 12,
                        "line_height": 1.5,
                        "text_align": "center"
                      }
                    },
                    "id": "86dd073f2473419cb44cdb0768152d88",
                    "data_id": "0ef73c00a80144efa3530025799a5de9"
                  },
                  {
                    "content_type": "block",
                    "type": "text",
                    "data": {
                      "content": "<p style=\"margin:0;color:#f9f8f1;\">Real matcha, made for water. One little packet, 8–12 oz of cold water, shake or stir. That’s the whole ritual.</p>",
                      "display_options": {},
                      "styles": {
                        "block_background_color": "#2e4b21",
                        "block_padding_bottom": 0,
                        "block_padding_left": 0,
                        "block_padding_right": 0,
                        "block_padding_top": 0,
                        "color": "#2e4b21",
                        "font_family": "Figtree, Arial, sans-serif",
                        "font_size": 17,
                        "inner_padding_bottom": 16,
                        "inner_padding_left": 32,
                        "inner_padding_right": 32,
                        "inner_padding_top": 0,
                        "line_height": 1.5,
                        "text_align": "center"
                      }
                    },
                    "id": "90de0487cfb4459f9c9d70d7cf41ce49",
                    "data_id": "659542a8841946d4b2ccc2a36334c977"
                  },
                  {
                    "content_type": "block",
                    "type": "text",
                    "data": {
                      "content": "<p style=\"margin:0;color:#f9f8f1;\">Three flavors: <strong>Strawberry</strong>, <strong>White Peach</strong> and <strong>Lemon Yuzu</strong>. Every packet also carries iron, vitamin C and collagen — we’ll tell you why in a couple of days.</p>",
                      "display_options": {},
                      "styles": {
                        "block_background_color": "#2e4b21",
                        "block_padding_bottom": 0,
                        "block_padding_left": 0,
                        "block_padding_right": 0,
                        "block_padding_top": 0,
                        "color": "#2e4b21",
                        "font_family": "Figtree, Arial, sans-serif",
                        "font_size": 17,
                        "inner_padding_bottom": 12,
