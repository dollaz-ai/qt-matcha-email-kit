                      "content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f9f8f1;border-radius:20px;\"><tr><td style=\"padding:20px 16px;text-align:center;\"><p style=\"margin:0 0 6px;padding:0;font-size:11px;letter-spacing:1.5px;font-weight:700;\">A LITTLE WELCOME GIFT</p><p style=\"margin:0;padding:0;font-family:Menlo,Consolas,monospace;font-size:30px;line-height:1.3;font-weight:700;letter-spacing:2px;\">QTCLUB15</p><p style=\"margin:8px 0 0;padding:0;font-size:13px;\">15% off your first order · one per customer</p></td></tr></table>",
